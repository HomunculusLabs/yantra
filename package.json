{
  "name": "yantra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.22",
  "main": "dist/electron/main.js",
  "engines": {
    "bun": "1.2.22",
    "node": "22.x"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "node-pty"
  ],
  "scripts": {
    "dev": "bun run build:electron && bun run electron dist/electron/main.js",
    "dev:web:child": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:daemon:child": "node --import tsx server/yantra-daemon.ts",
    "debug:chrome": "bash scripts/launch-chrome-debug.sh",
    "build:web": "next build",
    "build:daemon": "node scripts/build-runtime-bundles.mjs daemon",
    "build:electron": "node scripts/build-runtime-bundles.mjs electron",
    "stage:desktop": "node scripts/stage-desktop.mjs",
    "verify:supply-chain": "node scripts/verify-supply-chain.mjs",
    "verify:desktop-runtime": "node scripts/verify-desktop-runtime.mjs",
    "doctor:native": "node scripts/repair-native-macos.mjs",
    "build": "bun run build:web && bun run build:daemon && bun run build:electron && bun run stage:desktop && bun run verify:desktop-runtime",
    "dist": "bun run build && bun run electron-builder --config electron-builder.yml",
    "start:web": "next start --hostname 127.0.0.1 --port 3000",
    "start:daemon": "node dist/daemon/yantra-daemon.js",
    "start": "bun run start:web & bun run start:daemon",
    "lint": "eslint .",
    "lint:conversation-history": "eslint src/components/ai-panel/agent-chats-panel.tsx src/components/ai-panel/conversation-composer.tsx src/components/ai-panel/conversation-thread-renderer-registry.tsx src/components/ai-panel/conversation-thread-view.tsx src/components/ai-panel/use-conversation-thread.ts src/app/api/agents/conversations src/lib/agents/conversation-output-parser.ts src/lib/agents/conversation-reconciler.ts src/lib/agents/conversation-store.ts src/lib/agents/conversation-thread.ts src/stores/agent-creation-draft-store.ts src/types/conversations.ts",
    "typecheck": "bun x tsc --noEmit",
    "typecheck:conversation-history": "bun x tsc --noEmit -p tsconfig.conversation-history.json",
    "test": "bun test",
    "test:conversation-history": "bun test src/test/agents/conversation-output-parser.test.ts src/test/agents/conversation-runtime-progress.test.ts src/test/agents/conversation-store.test.ts src/test/agents/conversation-thread.test.ts src/test/api/agents-personas-route.test.ts src/test/api/agents-conversations-route.test.ts src/test/api/agents-conversations-id-route.test.ts src/test/api/agents-conversations-id-events-route.test.ts",
    "verify:conversation-history": "bun run lint:conversation-history && bun run typecheck:conversation-history && bun run test:conversation-history"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/legacy-modes": "6.5.2",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.0",
    "@tailwindcss/typography": "0.5.19",
    "@tiptap/extension-code-block-lowlight": "3.20.4",
    "@tiptap/extension-image": "3.20.4",
    "@tiptap/extension-placeholder": "3.20.4",
    "@tiptap/extension-table": "3.20.4",
    "@tiptap/extension-table-cell": "3.20.4",
    "@tiptap/extension-table-header": "3.20.4",
    "@tiptap/extension-table-row": "3.20.4",
    "@tiptap/extension-task-item": "3.20.4",
    "@tiptap/extension-task-list": "3.20.4",
    "@tiptap/pm": "3.20.4",
    "@tiptap/react": "3.20.4",
    "@tiptap/starter-kit": "3.20.4",
    "@uiw/react-codemirror": "4.25.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "absurd-sdk": "0.3.0",
    "better-sqlite3": "12.8.0",
    "chokidar": "5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.0",
    "flexsearch": "0.8.212",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "gray-matter": "4.0.3",
    "html2canvas": "1.4.1",
    "js-yaml": "4.1.1",
    "jspdf": "4.2.1",
    "lowlight": "3.3.0",
    "lucide-react": "0.577.0",
    "next": "16.2.1",
    "next-themes": "0.4.6",
    "node-cron": "4.2.1",
    "node-pty": "1.1.0",
    "pg": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "shadcn": "4.1.0",
    "sigma": "^3.0.2",
    "simple-git": "3.33.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "turndown": "7.2.2",
    "turndown-plugin-gfm": "1.0.2",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5",
    "ws": "8.19.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.37",
    "@types/node-cron": "3.0.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.1",
    "electron": "41.1.1",
    "electron-builder": "26.8.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "4.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
