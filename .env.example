# Optional: set a password to protect the UI (leave empty for no auth)
KB_PASSWORD=

# Optional: domain for the app
DOMAIN=localhost

# Desktop/source default: keep the daemon bound to loopback.
YANTRA_DAEMON_HOST=127.0.0.1
# Optional override when the daemon is exposed behind a reverse proxy.
# YANTRA_DAEMON_PUBLIC_ORIGIN=https://yantra.example.com

# Required for durable agent jobs: Postgres with Absurd schema + queue support
ABSURD_DATABASE_URL=postgresql://absurd:absurd@localhost:5433/absurd
YANTRA_ABSURD_QUEUE=agent-jobs
# Each agent uses its own queue derived from this prefix, e.g. agent-jobs-ceo
